<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Do not fail build on transient NuGet audit advisories -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Module encapsulation: use cases, domain types, DbContexts and jobs are internal.
    A module Core exposes its internals only to its own Adapters (DI registration) and to the unit test projects.
  -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('LoanSystem.Modules.')) And $(MSBuildProjectName.EndsWith('.Core'))">
    <InternalsVisibleTo Include="$(MSBuildProjectName.Replace('.Core', '.Adapters'))" />
    <InternalsVisibleTo Include="LoanSystem.Domain.UnitTests" />
    <InternalsVisibleTo Include="LoanSystem.Application.UnitTests" />
  </ItemGroup>
</Project>
