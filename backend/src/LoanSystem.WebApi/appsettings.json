{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Secrets": {
    "Provider": "None",
    "ReloadInterval": "00:05:00"
  },
  "Jwt": {
    "Issuer": "LoanSystem.Identity",
    "Audience": "LoanSystem.App",
    "AccessTokenMinutes": 30,
    "ClockSkewSeconds": 60,
    "RotationWarningDays": 14,
    "MinRsaKeySizeBits": 2048
  },
  "Security": {
    "RefreshTokenDays": 14,
    "MaxFailedAttempts": 5,
    "LockWindowMinutes": 15,
    "Mfa": {
      "RequiredRoles": [ "ROLE_ADMIN", "ROLE_OPERATOR" ],
      "Issuer": "LoanSystem",
      "ChallengeMinutes": 5,
      "EnrollmentChallengeMinutes": 10,
      "MaxAttemptsPerChallenge": 5,
      "AllowedDriftSteps": 1
    }
  },
  "Approvals": {
    "DefaultExpirationHours": 72,
    "ExpirationHours": {
      "PAYMENT_REVERSAL": 48,
      "LOAN_WRITE_OFF": 168,
      "LOAN_RESTRUCTURE": 168
    },
    "MfaStepUpOperations": [ "*" ],
    "WriteOffMinDaysLate": 180
  },
  "Idempotency": {
    "ResponseTtl": "1.00:00:00",
    "InProgressTtl": "00:02:00"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
