{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Secrets": {
    "Provider": "None",
    "ReloadInterval": "00:05:00"
  },
  "Jwt": {
    "Issuer": "LoanSystem.Identity",
    "Audience": "LoanSystem.App",
    "AccessTokenMinutes": 30,
    "ClockSkewSeconds": 60,
    "RotationWarningDays": 14,
    "MinRsaKeySizeBits": 2048
  },
  "Security": {
    "RefreshTokenDays": 14,
    "MaxFailedAttempts": 5,
    "LockWindowMinutes": 15,
    "Mfa": {
      "RequiredRoles": [ "ROLE_ADMIN", "ROLE_OPERATOR" ],
      "Issuer": "LoanSystem",
      "ChallengeMinutes": 5,
      "EnrollmentChallengeMinutes": 10,
      "MaxAttemptsPerChallenge": 5,
      "AllowedDriftSteps": 1
    }
  },
  "Approvals": {
    "DefaultExpirationHours": 72,
    "ExpirationHours": {
      "PAYMENT_REVERSAL": 48,
      "LOAN_WRITE_OFF": 168,
      "LOAN_RESTRUCTURE": 168
    },
    "MfaStepUpOperations": [ "*" ],
    "WriteOffMinDaysLate": 180
  },
  "Idempotency": {
    "ResponseTtl": "1.00:00:00",
    "InProgressTtl": "00:02:00"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Customers": {
    "Kyc": {
      "ValidityMonths": 12,
      "ExpiringSoonDays": 30,
      "IncomeProofThreshold": 3000.00
    },
    "Documents": {
      "MaxFileSizeMb": 10,
      "SignedUrlTtlSeconds": 300,
      "AllowedTypes": [ "image/jpeg", "image/png", "image/webp", "application/pdf" ]
    },
    "Storage": {
      "Provider": "Local",
      "LocalPath": "./.storage",
      "Bucket": "",
      "Region": "",
      "ServiceUrl": "",
      "ForcePathStyle": true
    },
    "IdentityVerifier": {
      "Provider": "Fake",
      "TimeoutSeconds": 15
    },
    "BankAccounts": {
      "CoolingPeriodHours": 24,
      "MaxActivePerCustomer": 5
    },
    "Otp": {
      "Length": 6,
      "TtlSeconds": 300,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "MaxSendsPerHour": 5
    }
  }
}
