{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Customers": {
    "Kyc": {
      "ValidityMonths": 12,
      "ExpiringSoonDays": 30,
      "IncomeProofThreshold": 3000.00
    },
    "Documents": {
      "MaxFileSizeMb": 10,
      "SignedUrlTtlSeconds": 300,
      "AllowedTypes": [ "image/jpeg", "image/png", "image/webp", "application/pdf" ]
    },
    "Storage": {
      "Provider": "Local",
      "LocalPath": "./.storage",
      "Bucket": "",
      "Region": "",
      "ServiceUrl": "",
      "ForcePathStyle": true
    },
    "IdentityVerifier": {
      "Provider": "Fake",
      "TimeoutSeconds": 15
    },
    "BankAccounts": {
      "CoolingPeriodHours": 24,
      "MaxActivePerCustomer": 5
    },
    "Otp": {
      "Length": 6,
      "TtlSeconds": 300,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "MaxSendsPerHour": 5
    }
  }
}
