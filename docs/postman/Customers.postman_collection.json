        {
          "name": "Verify Bank Account Ownership",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holderName\": \"Ana María Quispe\",\n  \"method\": \"MANUAL\",\n  \"notes\": \"Constancia CCI validada.\"\n}"
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/bank-accounts/{{accountId}}/verify"
          },
          "response": [
            {
              "name": "422 Unprocessable Entity — Customers.AccountHolderMismatch",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\n  \"title\": \"Unprocessable Entity\",\n  \"status\": 422,\n  \"detail\": \"El titular de la cuenta bancaria no coincide con el nombre del cliente.\",\n  \"code\": \"Customers.AccountHolderMismatch\"\n}"
            }
          ]
        },
        {
          "name": "Deactivate Bank Account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/customers/{{customerId}}/bank-accounts/{{accountId}}"
          },
          "response": []
        },
        {
          "name": "Set Primary Bank Account (Initiates OTP when replacing existing primary)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 202) {",
                  "  const body = pm.response.json();",
                  "  if (body.otpChallenge && body.otpChallenge.otpRequestId) {",
                  "    pm.collectionVariables.set('otpRequestId', body.otpChallenge.otpRequestId);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/customers/{{customerId}}/bank-accounts/{{accountId}}/primary"
          },
          "response": [
            {
              "name": "422 Unprocessable Entity — Customers.AccountNotVerified",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\n  \"title\": \"Unprocessable Entity\",\n  \"status\": 422,\n  \"detail\": \"Solo cuentas activas y verificadas pueden designarse como primarias.\",\n  \"code\": \"Customers.AccountNotVerified\"\n}"
            }
          ]
        },
        {
          "name": "Confirm Primary Bank Account Change (OTP + 24h Cooling)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpRequestId\": \"{{otpRequestId}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/bank-accounts/{{accountId}}/primary/confirm"
          },
          "response": [
            {
              "name": "422 Unprocessable Entity — Customers.OtpInvalid",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\n  \"title\": \"Unprocessable Entity\",\n  \"status\": 422,\n  \"detail\": \"Código OTP inválido.\",\n  \"code\": \"Customers.OtpInvalid\"\n}"
            },
            {
              "name": "423 Locked — Customers.OtpLocked",
              "status": "Locked",
              "code": 423,
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\n  \"title\": \"Locked\",\n  \"status\": 423,\n  \"detail\": \"OTP bloqueado por exceso de intentos fallidos.\",\n  \"code\": \"Customers.OtpLocked\"\n}"
            }
          ]
        },
        {
          "name": "Start Contact Verification (OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.otpRequestId) pm.collectionVariables.set('otpRequestId', body.otpRequestId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"EMAIL\"\n}"
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/contact/verify/start"
          },
          "response": [
            {
              "name": "422 Unprocessable Entity — Customers.OtpResendTooSoon",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\n  \"title\": \"Unprocessable Entity\",\n  \"status\": 422,\n  \"detail\": \"Debe esperar antes de reenviar un nuevo código OTP.\",\n  \"code\": \"Customers.OtpResendTooSoon\",\n  \"retryAfterSeconds\": 45\n}"
            }
          ]
        },
        {
          "name": "Confirm Contact Verification (OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpRequestId\": \"{{otpRequestId}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/contact/verify/confirm"
          },
          "response": [
            {
              "name": "422 Unprocessable Entity — Customers.OtpExpired",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\n  \"title\": \"Unprocessable Entity\",\n  \"status\": 422,\n  \"detail\": \"El código OTP ha expirado.\",\n  \"code\": \"Customers.OtpExpired\"\n}"
            },
            {
              "name": "422 Unprocessable Entity — Customers.OtpAlreadyUsed",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\n  \"title\": \"Unprocessable Entity\",\n  \"status\": 422,\n  \"detail\": \"El código OTP ya fue utilizado o invalidado.\",\n  \"code\": \"Customers.OtpAlreadyUsed\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
