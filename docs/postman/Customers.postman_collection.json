              "body": "{\n  \"title\": \"Unprocessable Entity\",\n  \"status\": 422,\n  \"detail\": \"Solo el consentimiento de MARKETING puede revocarse directamente por esta vía.\",\n  \"code\": \"Customers.ConsentNotRevocable\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Bank Accounts & OTP (BE-CUS-09, 10, 11)",
      "item": [
        {
          "name": "Register Bank Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('accountId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankName\": \"BCP\",\n  \"accountType\": \"CUENTA_AHORRO\",\n  \"cci\": \"00219300012345678901\",\n  \"phoneWallet\": null,\n  \"gatewayToken\": null,\n  \"holderName\": \"Ana María Quispe\"\n}"
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}/bank-accounts"
          },
          "response": [
            {
              "name": "400 Bad Request — Customers.InvalidCci",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
